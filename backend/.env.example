# ============================================================
# ROZZA BACKEND — Environment Variables
# Copy this file to .env and fill in your keys.
# NEVER commit .env to git.
# ============================================================

# ─── Active AI Provider ──────────────────────────────────────
# Options: groq | openai | gemini | claude
ACTIVE_AI_PROVIDER=openai

# ─── AI Provider Keys ────────────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ─── YouTube Data API v3 ─────────────────────────────────────
YOUTUBE_API_KEY=

# ─── Legal native-audio providers ───────────────────────────
# Audius currently supports public read/stream access; a key is optional.
AUDIUS_API_KEY=

# Free — register an app at https://devportal.jamendo.com/ and paste the
# "Client ID". Without it every Jamendo search silently returns nothing.
JAMENDO_CLIENT_ID=

# Comma-separated HTTPS hosts you control or are authorized to stream from.
AUTHORIZED_AUDIO_HOSTS=

# ─── Spotify (catalog search only; playback is App Remote on device) ────────
# From https://developer.spotify.com/dashboard. The secret never leaves the
# backend; the app only ever sees the public client ID.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── AudD Music Recognition ──────────────────────────────────
AUDD_API_KEY=

# ─── Server Config ───────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Where the SQLite catalog lives. In production point this at a mounted volume
# so a redeploy does not wipe everything ROZZA has discovered.
ROZZA_DATA_DIR=

# Shared secret the app sends as x-rozza-token. Leave blank for local dev.
# Set it (any long random string) once the backend is publicly reachable, and
# put the same value in the app's EXPO_PUBLIC_ROZZA_APP_TOKEN.
ROZZA_APP_TOKEN=

# Comma-separated browser origins for the web build. Blank means allow all.
ALLOWED_ORIGINS=

# ─── Admin / Health Endpoint Protection ─────────────────────
ADMIN_SEED_TOKEN=

# ─── Cache Config ────────────────────────────────────────────
SEARCH_CACHE_TTL_MINUTES=60
TRENDING_CACHE_TTL_MINUTES=30
YOUTUBE_DAILY_QUOTA_UNITS=9000
